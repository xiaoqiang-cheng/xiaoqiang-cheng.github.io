---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { render } from "astro:content";

type Props = CollectionEntry<"projects"> & { compact?: boolean };

const { data, compact = false, ...entry } = Astro.props;
const { name, description, url, repo, image, tags } = data;
const href = url ?? repo;
const { Content } = await render({ data, ...entry } as CollectionEntry<"projects">);
const hasBody = (entry.body ?? "").trim().length > 0;
---

<li
  class="border-border bg-background flex flex-col gap-3 rounded-lg border p-4 transition-colors hover:border-accent/60"
>
  {
    image && (
      <a href={href} target="_blank" rel="noopener noreferrer" class="block">
        <Image
          src={image}
          alt={name}
          width={640}
          class="border-border aspect-[16/9] w-full rounded-md border object-cover"
          loading="lazy"
        />
      </a>
    )
  }
  <div class="min-w-0">
    <h3 class="text-lg font-semibold">
      {
        href ? (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-accent decoration-dashed underline-offset-4 hover:underline"
          >
            {name}
          </a>
        ) : (
          name
        )
      }
    </h3>
    <p class="text-muted-foreground mt-1 text-sm leading-relaxed">
      {description}
    </p>
    {
      !compact && hasBody && (
        <div class="app-prose prose-sm mt-2 max-w-none">
          <Content />
        </div>
      )
    }
    <div class="mt-3 flex flex-wrap items-center gap-2 text-xs">
      {
        tags.map(tag => (
          <span class="bg-muted rounded px-2 py-0.5">{tag}</span>
        ))
      }
      {
        repo && (
          <a
            href={repo}
            target="_blank"
            rel="noopener noreferrer"
            class="text-accent ms-auto hover:underline"
          >
            GitHub ↗
          </a>
        )
      }
    </div>
  </div>
</li>
