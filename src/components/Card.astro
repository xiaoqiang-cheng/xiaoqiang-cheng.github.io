---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import Datetime from "./Datetime.astro";
import { excerpt } from "@/utils/excerpt";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath, body } = Astro.props;

const { title, description: desc, ...props } = data;
const description = desc || excerpt(body);
---

<li class="border-border border-b py-4 first:pt-2 last:border-b-0">
  <div class="flex flex-col gap-1.5 sm:flex-row sm:items-baseline sm:gap-5">
    <Datetime {...props} class="sm:w-28 sm:shrink-0" />
    <div class="min-w-0 flex-1">
      <a
        href={getPostUrl(id, filePath, Astro.currentLocale)}
        class:list={[
          "text-foreground hover:text-accent inline-block text-lg leading-snug font-semibold tracking-tight",
          "decoration-dashed underline-offset-4 hover:underline",
          "focus-visible:no-underline focus-visible:underline-offset-0",
        ]}
      >
        <Heading transition:name={toTransitionName(id)}>
          {title}
        </Heading>
      </a>
      {
        description && (
          <p class="text-muted-foreground mt-1 text-sm leading-relaxed">
            {description}
          </p>
        )
      }
      {
        props.tags?.length > 0 && (
          <p class="text-muted-foreground mt-1.5 flex flex-wrap gap-x-3 text-xs">
            {props.tags.map((tag: string) => (
              <span>#{tag}</span>
            ))}
          </p>
        )
      }
    </div>
  </div>
</li>
