---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { Image } from "astro:assets";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";
import avatar from "@/assets/images/avatar.jpg";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

const projects = (await getCollection("projects"))
  .filter(p => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section
      id="hero"
      class="border-border flex flex-col gap-6 border-b pt-10 pb-8 sm:flex-row sm:items-start"
    >
      <Image
        src={avatar}
        alt="程晓强"
        width={160}
        height={160}
        class="border-border size-28 shrink-0 rounded-full border object-cover sm:size-36"
        loading="eager"
      />
      <div class="min-w-0 flex-1">
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
          程晓强
          <span class="text-muted-foreground ms-1 text-lg font-normal"
            >Xiaoqiang Cheng</span
          >
          <a
            target="_blank"
            href="/rss.xml"
            class="ms-2 inline-block align-middle"
            aria-label="RSS"
            title="RSS"
          >
            <IconRss
              width={18}
              height={18}
              class="stroke-accent inline-block scale-110 stroke-3"
            />
          </a>
        </h1>
        <p class="mt-3 leading-relaxed">
          自动驾驶感知算法工程师。天津大学硕士，研究基于 LiDAR
          的目标检测与跟踪；现就职于驭势科技（UISEE），负责感知算法的研发与落地。
          擅长 2D/3D 检测、跟踪、分割，以及 TensorRT / CUDA 等部署加速。
        </p>
        <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
          Perception engineer working on autonomous driving. I write about
          computer vision, deployment, and the tools I build along the way.
        </p>
        <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
          <Socials />
          <LinkButton
            href="/about/"
            class="hover:text-accent text-sm underline decoration-dashed underline-offset-4"
            >{t.nav.about}</LinkButton
          >
          <LinkButton
            href="/cv/xiaoqiang-cheng-cv.pdf"
            class="hover:text-accent text-sm underline decoration-dashed underline-offset-4"
            target="_blank">CV</LinkButton
          >
        </div>
      </div>
    </section>

    {
      projects.length > 0 && (
        <section id="projects" class="border-border border-b pt-10 pb-6">
          <div class="flex items-baseline justify-between">
            <h2 class="text-2xl font-semibold tracking-wide">
              {t.nav.projects}
            </h2>
            <LinkButton
              href="/projects/"
              class="hover:text-accent text-sm underline decoration-dashed underline-offset-4"
            >
              全部项目
            </LinkButton>
          </div>
          <ul class="mt-4 grid gap-4 sm:grid-cols-3">
            {projects.map(project => (
              <ProjectCard {...project} compact />
            ))}
          </ul>
        </section>
      )
    }

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-10 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-10 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
