---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { Image } from "astro:assets";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";
import avatar from "@/assets/images/avatar.jpg";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const hasMore = recentPosts.length > postsConfig.perIndex;

const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section
      id="hero"
      class="border-border flex items-center gap-5 border-b py-8 sm:gap-6"
    >
      <Image
        src={avatar}
        alt="程晓强"
        width={128}
        height={128}
        class="border-border size-16 shrink-0 rounded-full border object-cover sm:size-20"
        loading="eager"
      />
      <div class="min-w-0 flex-1">
        <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">
          程晓强
          <span class="text-muted-foreground ms-1 text-base font-normal"
            >Xiaoqiang Cheng</span
          >
        </h1>
        <p class="text-muted-foreground mt-1 leading-relaxed">
          自动驾驶感知算法工程师。记录技术笔记、工具分享与生活随笔。
          <a
            href="/about/"
            class="text-foreground hover:text-accent underline decoration-dashed underline-offset-4"
            >{t.nav.about} →</a
          >
        </p>
        <div class="mt-2 -ms-1"><Socials /></div>
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section id="featured" class="pt-8">
          <h2 class="text-muted-foreground text-sm font-medium tracking-widest uppercase">
            {t.home.featured}
          </h2>
          <ul class="mt-2">
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <section id="recent-posts" class="pt-8">
      <h2
        class="text-muted-foreground text-sm font-medium tracking-widest uppercase"
      >
        {t.home.recentPosts}
      </h2>
      <ul class="mt-2">
        {
          recentPosts
            .slice(0, postsConfig.perIndex)
            .map(data => <Card variant="h3" {...data} />)
        }
      </ul>
    </section>

    {
      hasMore && (
        <div class="my-10 text-center">
          <LinkButton
            href={getRelativeLocaleUrl(locale, "posts")}
            class="hover:text-accent underline decoration-dashed underline-offset-4"
          >
            {t.home.allPosts}
            <IconArrowRight class="inline-block rtl:-rotate-180" />
          </LinkButton>
        </div>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
